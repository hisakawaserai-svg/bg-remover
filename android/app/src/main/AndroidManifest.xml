<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ギャラリー読み込み用（Android 12以下） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Android 13 以上では写真の読み取り許可（READ_MEDIA_IMAGES）を宣言しない。
         画像はシステムの写真ピッカー（react-native-image-picker）で選ぶので許可が要らず、
         保存と「保存先」画面の一覧は、このアプリが保存した画像だけを扱うので許可なしで読める。
         Google Play のポリシーでも、ピッカーで足りるアプリはこの許可を要求できない（1.2.2 の審査で指摘）。 -->
    <!-- ギャラリー書き込み用（Android 9以下） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- ML Kit 被写体検出モデルを Play からインストール時に取る。
           無いと初回推論の直前ダウンロードになり、オフラインだと失敗しやすい。
           https://developers.google.com/ml-kit/vision/subject-segmentation/android -->
      <meta-data
        android:name="com.google.mlkit.vision.DEPENDENCIES"
        android:value="subject_segment" />
      <!-- AdMob の APPLICATION_ID はここに直書きしない。
           react-native-google-mobile-ads が app.json の android_app_id を読んで
           ライブラリ側マニフェストのプレースホルダに埋める（単一の出所に保つ）。 -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- 他アプリからの画像共有（1枚のみ）を受け取る -->
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="image/*" />
        </intent-filter>
      </activity>
    </application>
</manifest>
